        @* ─── Etichette binari ─── *@
        <svg:text x="22" y="17" font-size="7" fill="#1a1a1a" font-weight="bold">B1</svg:text>
        <svg:text x="22" y="39" font-size="7" fill="#1a1a1a" font-weight="bold">B2</svg:text>
        <svg:text x="134" y="62" font-size="7" fill="#1a1a1a" font-weight="bold">B3</svg:text>
        <svg:text x="269" y="85" font-size="7" fill="#1a1a1a" font-weight="bold">B4</svg:text>
        <svg:text x="364" y="182" font-size="7" fill="#333" font-weight="bold">Morto 1</svg:text>
        <svg:text x="296" y="170" font-size="7" fill="#333" font-weight="bold">Morto 2</svg:text>

        @* ─── Frecce ingresso/uscita ─── *@
        <line x1="5" y1="22.453" x2="20" y2="22.453" stroke="#b00020" stroke-width="1.5" marker-end="url(#arr-r)"/>
        <line x1="500" y1="22.453" x2="485" y2="22.453" stroke="#b00020" stroke-width="1.5" marker-end="url(#arr-l)"/>
        <svg:text x="3" y="18" font-size="5.5" fill="#b00020" font-weight="bold">IN</svg:text>
        <svg:text x="496" y="18" font-size="5.5" fill="#b00020" font-weight="bold" text-anchor="end">OUT</svg:text>

        @* ─── Semafori + portali ingressi ─── *@
        @* Per ogni binario di transito: cerchio verde/rosso a sinistra e destra *@
        @{
            var ptSem = Tracks.Where(t => t.Type == "transit").OrderBy(t => t.Id).ToList();
        }
        @for (int si = 0; si < ptSem.Count && si < HorizontalTracks.Length; si++)
        {
            var semTrack = ptSem[si];
            var (hsx, hsy, hex2, hey2) = HorizontalTracks[si];
            var leftFree  = semTrack.Zones.Count > 0 && !semTrack.Zones[0].IsOccupied;
            var rightFree = semTrack.Zones.Count > 0 && !semTrack.Zones[^1].IsOccupied;
            var leftColor  = leftFree  ? "#28a745" : "#dc3545";
            var rightColor = rightFree ? "#28a745" : "#dc3545";

            // Semaforo sinistro
            <circle cx="@F(hsx - 6)" cy="@F(hsy)" r="2.8" fill="@leftColor" stroke="white" stroke-width="0.5"/>
            // Semaforo destro
            <circle cx="@F(hex2 + 6)" cy="@F(hey2)" r="2.8" fill="@rightColor" stroke="white" stroke-width="0.5"/>
        }

        @* ─── Indicatori coda in ingresso ─── *@
        @if (WaitingLeft > 0)
        {
            <g>
                <rect x="1" y="95" width="20" height="11" fill="#ffc107" rx="2" opacity="0.9"/>
                <svg:text x="11" y="104" font-size="7" fill="#1a1a1a" text-anchor="middle" font-weight="bold">
                    +@WaitingLeft
                </svg:text>
            </g>
        }
        @if (WaitingRight > 0)
        {
            <g>
                <rect x="489" y="95" width="20" height="11" fill="#ffc107" rx="2" opacity="0.9"/>
                <svg:text x="499" y="104" font-size="7" fill="#1a1a1a" text-anchor="middle" font-weight="bold">
                    +@WaitingRight
                </svg:text>
            </g>
        }

        @* ═══════════════════════════════════════════════════════════ *@
        @* OVERLAY DINAMICO — treni                                    *@
        @* ═══════════════════════════════════════════════════════════ *@
        @{
            var passTracks = Tracks.Where(t => t.Type == "transit").OrderBy(t => t.Id).ToList();
            var maintTracks = Tracks.Where(t => t.Type == "maintenance").OrderBy(t => t.Id).ToList();
        }

        @* ─── Treni sui binari di transito ─── *@
        @for (int i = 0; i < passTracks.Count && i < HorizontalTracks.Length; i++)
        {
            var track = passTracks[i];
            var (tsx, tsy, tex, tey) = HorizontalTracks[i];
            var zoneW = track.Zones.Count > 0 ? (tex - tsx) / track.Zones.Count : 23.5;

            foreach (var block in TrainBlocks(track))
            {
                var x1p = HZoneX(i, block.StartIdx, track.Zones.Count) - HZoneHalf(i, track.Zones.Count);
                var x2p = HZoneX(i, block.EndIdx,   track.Zones.Count) + HZoneHalf(i, track.Zones.Count);
                var cw   = x2p - x1p;
                var fill = TrainFill(block.Train!);
                var t    = block.Train!;

                @* Ghost ingresso: zona del treno ancora fuori dal binario *@
                @if (!t.IsExiting && t.VisibleZoneCount < t.ZoneCount)
                {
                    var ghostZones = t.ZoneCount - t.VisibleZoneCount;
                    if (t.Direction == 1)
                    {
                        // Entra da sinistra: ghost a sinistra del binario
                        var gw = Math.Min(ghostZones * zoneW, tsx);
                        if (gw > 1)
                        {
                            <rect x="@F(tsx - gw)" y="@F(tsy - 4)" width="@F(gw)" height="8"
                                  fill="@fill" rx="1" opacity="0.22"/>
                            <line x1="@F(tsx - gw)" y1="@F(tsy)" x2="@F(tsx)" y2="@F(tsy)"
                                  stroke="@fill" stroke-width="1.5" stroke-dasharray="2,2" opacity="0.45"/>
                        }
                    }
                    else
                    {
                        // Entra da destra: ghost a destra del binario
                        var gw = Math.Min(ghostZones * zoneW, 510.0 - tex);
                        if (gw > 1)
                        {
                            <rect x="@F(tex)" y="@F(tsy - 4)" width="@F(gw)" height="8"
                                  fill="@fill" rx="1" opacity="0.22"/>
                            <line x1="@F(tex)" y1="@F(tsy)" x2="@F(tex + gw)" y2="@F(tsy)"
                                  stroke="@fill" stroke-width="1.5" stroke-dasharray="2,2" opacity="0.45"/>
                        }
                    }
                }

                <g>
                    <rect x="@F(x1p)" y="@F(tsy - 6)" width="@F(cw)" height="12"
                          fill="@fill" rx="2" ry="2"
                          stroke="rgba(0,0,0,0.4)" stroke-width="0.5"
                          opacity="@(t.IsExiting ? "0.55" : "1")"/>
                    @if (t.Direction == 1)
                    {
                        <polygon points="@F(x2p - 4),@F(tsy - 4) @F(x2p),@F(tsy) @F(x2p - 4),@F(tsy + 4)"
                                 fill="rgba(0,0,0,0.25)" opacity="@(t.IsExiting ? "0.4" : "1")"/>
                    }
                    else
                    {
                        <polygon points="@F(x1p + 4),@F(tsy - 4) @F(x1p),@F(tsy) @F(x1p + 4),@F(tsy + 4)"
                                 fill="rgba(0,0,0,0.25)" opacity="@(t.IsExiting ? "0.4" : "1")"/>
                    }
                    @if (!t.IsExiting)
                    {
                        <svg:text x="@F((x1p + x2p) / 2)" y="@F(tsy + 3.5)" font-size="7"
                                  fill="white" text-anchor="middle" font-weight="bold"
                                  style="pointer-events:none; text-shadow: 0 0 2px rgba(0,0,0,0.8)">
                            @t.Code
                        </svg:text>
                    }
                    <title>Treno @t.Code (@t.Type) · @TrainStatus(t)</title>
                </g>
            }
        }

        @* ─── Treni sui binari morti (diagonali) ─── *@
        @for (int m = 0; m < maintTracks.Count && m < DiagonalTracks.Length; m++)
        {
            var track = maintTracks[m];
            var (dsx, dsy, dex, dey) = DiagonalTracks[m];
            var count = track.Zones.Count;
            var angle = Math.Atan2(dey - dsy, dex - dsx) * 180.0 / Math.PI;

            foreach (var block in TrainBlocks(track))
            {
                var tStart = (double)block.StartIdx / count;
                var tEnd   = (double)(block.EndIdx + 1) / count;
                var px1 = dsx + (dex - dsx) * tStart;
                var py1 = dsy + (dey - dsy) * tStart;
                var px2 = dsx + (dex - dsx) * tEnd;
                var py2 = dsy + (dey - dsy) * tEnd;
                var cx  = (px1 + px2) / 2;
                var cy  = (py1 + py2) / 2;
                var w   = Math.Sqrt(Math.Pow(px2 - px1, 2) + Math.Pow(py2 - py1, 2));
                var fill = TrainFill(block.Train!);

                <g transform="rotate(@F(angle) @F(cx) @F(cy))">
                    <rect x="@F(cx - w / 2)" y="@F(cy - 5)" width="@F(w)" height="10"
                          fill="@fill" rx="2" ry="2"
                          stroke="rgba(0,0,0,0.4)" stroke-width="0.5"/>
                    <svg:text x="@F(cx)" y="@F(cy + 3)" font-size="6"
                              fill="white" text-anchor="middle" font-weight="bold"
                              style="pointer-events:none">
                        @block.Train!.Code
                    </svg:text>
                    <title>Treno @block.Train!.Code (@block.Train!.Type) · In manutenzione · @TrainStatus(block.Train!)</title>
                </g>
            }
        }

        @* ─── Legenda ─── *@
        <g transform="translate(5, 193)">
            <rect x="0"   y="0" width="9" height="9" fill="#0d6efd" rx="1"/>
            <svg:text x="12"  y="8" font-size="7.5" fill="#333">Passeggeri (R/V/F)</svg:text>
            <rect x="115" y="0" width="9" height="9" fill="#dc3545" rx="1"/>
            <svg:text x="127" y="8" font-size="7.5" fill="#333">Merci (T/S)</svg:text>
            <rect x="195" y="0" width="9" height="9" fill="#0a58ca" rx="1"/>
            <svg:text x="207" y="8" font-size="7.5" fill="#333">In sosta</svg:text>
            <line x1="270" y1="5" x2="283" y2="5" stroke="#b00020" stroke-width="1.8" marker-end="url(#arr-r)"/>
            <svg:text x="287" y="8" font-size="7.5" fill="#333">Ingresso/Uscita</svg:text>
            <line x1="388" y1="5" x2="388" y2="14" stroke="#dc3545" stroke-width="2"/>
            <line x1="384" y1="9" x2="392" y2="9" stroke="#dc3545" stroke-width="2"/>
            <svg:text x="396" y="8" font-size="7.5" fill="#333">Fine binario morto</svg:text>
        </g>
    </svg>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SimTrack> Tracks { get; set; } = new List<SimTrack>();

    /// <summary>Treni in coda che entrano da sinistra (origin L*).</summary>
    [Parameter] public int WaitingLeft  { get; set; }
    /// <summary>Treni in coda che entrano da destra.</summary>
    [Parameter] public int WaitingRight { get; set; }

    // ── Coordinate SVG (da stazione.svg, viewBox 0 0 500 500) ──────────
    // Binari di transito: (startX, y, endX, y)
    private static readonly (double sx, double sy, double ex, double ey)[] HorizontalTracks =
    {
        ( 22.453,  22.453, 493.966,  22.453),   // B1 — piena larghezza
        ( 22.453,  44.906, 493.966,  44.906),   // B2 — piena larghezza
        (134.718,  67.359, 404.154,  67.359),   // B3 — parziale
        (269.436,  89.812, 359.248,  89.812),   // B4 — corto
    };

    // Binari morti (diagonali): (startX, startY, endX, endY)
    private static readonly (double sx, double sy, double ex, double ey)[] DiagonalTracks =
    {
        ( 44.906,  22.453, 359.248, 179.624),   // Morto 1 — si stacca da B1
        (157.171, 100.841, 291.889, 168.200),   // Morto 2 — si stacca da Morto 1
    };

    // ── Helpers coordinata zona (asse X) per binari orizzontali ────────
    private static double HZoneX(int trackIdx, int zoneIdx, int totalZones)
    {
        if ((uint)trackIdx >= (uint)HorizontalTracks.Length) return 0;
        var (sx, _, ex, _) = HorizontalTracks[trackIdx];
        if (totalZones <= 0) return sx;
        return sx + (zoneIdx + 0.5) * ((ex - sx) / totalZones);
    }

    private static double HZoneHalf(int trackIdx, int totalZones)
    {
        if ((uint)trackIdx >= (uint)HorizontalTracks.Length || totalZones <= 0) return 4;
        var (sx, _, ex, _) = HorizontalTracks[trackIdx];
        return ((ex - sx) / totalZones) / 2.0;
    }

    // ── Utility ────────────────────────────────────────────────────────
    private static string F(double v) => v.ToString("F2", CultureInfo.InvariantCulture);

    private sealed class TrainBlock
    {
        public SimTrain? Train    { get; set; }
        public int       StartIdx { get; set; }
        public int       EndIdx   { get; set; }
    }

    private static IEnumerable<TrainBlock> TrainBlocks(SimTrack track)
    {
        var seen = new HashSet<string>();
        for (int i = 0; i < track.Zones.Count; i++)
        {
            var train = track.Zones[i].Train;
            if (train == null || !seen.Add(train.Id)) continue;

            int start = i, end = i;
            for (int j = 0; j < track.Zones.Count; j++)
            {
                if (track.Zones[j].Train?.Id == train.Id)
                {
                    if (j < start) start = j;
                    if (j > end)   end   = j;
                }
            }
            yield return new TrainBlock { Train = train, StartIdx = start, EndIdx = end };
        }
    }

    /// <summary>
    /// Descrizione testuale dello stato corrente del treno (usata nei tooltip SVG).
    /// </summary>
    private static string TrainStatus(SimTrain t)
    {
        if (t.IsExiting)
            return $"In uscita — {t.VisibleZoneCount} zone rimaste";

        if (t.IsStopping)
            return $"In sosta — {t.TimeRemaining} tick rimasti";

        if (!t.HasStoppedAtPlatform && t.VisibleZoneCount < t.ZoneCount)
            return $"In ingresso — {t.VisibleZoneCount}/{t.ZoneCount} zone visibili";

        return "In transito";
    }

    /// <summary>
    /// Colore di riempimento del rettangolo SVG del treno.
    /// Sosta iniziale/finale → tono scuro  |  In transito → tono vivace.
    /// </summary>
    private static string TrainFill(SimTrain t) =>
        (t.IsStopping, t.Type) switch
        {
            (true,  "R" or "V" or "F") => "#0a58ca",   // blu scuro → in sosta passeggeri
            (true,  "T" or "S")        => "#a02533",   // rosso scuro → in sosta cargo
            (true,  _)                  => "#1f2326",
            (false, "R" or "V" or "F") => "#0d6efd",   // blu vivace → in transito
            (false, "T" or "S")        => "#dc3545",   // rosso vivace → transito cargo
            _                           => "#343a40",
        };
}
