        @* ─── Respingenti binari morti ─── *@
        <line x1="362" y1="174" x2="362" y2="185" stroke="#dc3545" stroke-width="2.5"/>
        <line x1="357" y1="179.624" x2="364" y2="179.624" stroke="#dc3545" stroke-width="2.5"/>
        <line x1="294" y1="163" x2="294" y2="174" stroke="#dc3545" stroke-width="2.5"/>
