@page "/dashboard"

<h3>Dashboard Stazione</h3>

<h4>Layout stazione</h4>
<StationLayout Tracks="SimService.Tracks" />

<h4 class="mt-4">Binari</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Binario</th>
            <th>Lunghezza</th>
            <th>Stato</th>
            <th>Tipo</th>
            <th>Treno assegnato</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sector in sectors)
        {
            var train = trains.FirstOrDefault(t => t.AssignedPlatform == sector.PlatformNumber);
            <tr>
                <td>@sector.PlatformNumber</td>
                <td>@sector.Length</td>
                <td>
                    <span class="badge @GetTrackClass(sector)">
                        @GetTrackStatusText(sector)
                    </span>
                </td>
                <td>@(train?.TrainType ?? "-")</td>
                <td>@(train?.TrainNumber ?? "-")</td>
            </tr>
        }
    </tbody>
</table>

<h4>Treni in Manutenzione</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Treno</th>
            <th>Tipo</th>
            <th>Binario</th>
            <th>Inizio</th>
            <th>Fine prevista</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in maintenance)
        {
            <tr>
                <td>@m.TrainLog?.TrainNumber</td>
                <td>@m.TrainLog?.TrainType</td>
                <td>@m.MaintenancePlatform</td>
                <td>@m.MaintenanceStart.ToLocalTime()</td>
                <td>@m.MaintenanceEnd.ToLocalTime()</td>
            </tr>
        }
    </tbody>
</table>

<h4>Treni in Transito / Attivi</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Treno</th>
            <th>Tipo</th>
            <th>Priorità</th>
            <th>Binario</th>
            <th>Arrivo programmato</th>
            <th>P. Partenza</th>
            <th>Ritardo</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in trains)
        {
            <tr>
                <td>@t.TrainNumber</td>
                <td>@t.TrainType</td>
                <td><span class="badge @GetPriorityBadge(t.TrainType)">@GetPriorityLabel(t.TrainType)</span></td>
                <td>@(t.AssignedPlatform?.ToString() ?? "N/A")</td>
                <td>@t.ScheduledArrivalTime.ToLocalTime()</td>
                <td>@t.ScheduledDepartureTime.ToLocalTime()</td>
                <td class="@GetDelayClass(t)">@GetDelayText(t)</td>
            </tr>
        }
    </tbody>
</table>

@if (waitingTrains.Count > 0)
{
    <h4 class="mt-4 text-warning">⏳ Treni in Attesa (coda priorità)</h4>
    <table class="table table-striped table-bordered">
        <thead class="table-warning">
            <tr>
                <th>Treno</th>
                <th>Tipo</th>
                <th>Priorità</th>
                <th>Origine</th>
                <th>Arrivo programmato</th>
                <th>In attesa da</th>
                <th>Ritardo accumulato</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (train, queuedAt) in waitingTrains.OrderByDescending(w =>
                StazioneFerroviaria.Services.SimulationService.GetTrainPriority(w.Train.TrainType)))
            {
                var waitMin = (int)(DateTime.UtcNow - queuedAt).TotalMinutes;
                <tr>
                    <td>@train.TrainNumber</td>
                    <td>@train.TrainType</td>
                    <td><span class="badge @GetPriorityBadge(train.TrainType)">@GetPriorityLabel(train.TrainType)</span></td>
                    <td>@train.Origin → @train.Destination</td>
                    <td>@train.ScheduledArrivalTime.ToLocalTime()</td>
                    <td>@(waitMin < 1 ? "< 1 min" : $"{waitMin} min")</td>
                    <td class="@GetDelayClass(train)">@GetDelayText(train)</td>
                </tr>
            }
        </tbody>
    </table>
}

<h4>Semafori</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Stato</th>
            <th>Deviazione</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in semaphores)
        {
            <tr>
                <td>@s.Id</td>
                <td>@(s.IsGreen ? "Verde" : "Rosso")</td>
                <td>@(s.IsDeviating ? "Attiva" : "Dritta")</td>
            </tr>
        }
    </tbody>
</table>

<h4>Scambi</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Input</th>
            <th>Dritto</th>
            <th>Deviazione</th>
            <th>Stato</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sw in switches)
        {
            <tr>
                <td>@sw.Id</td>
                <td>@sw.InputId</td>
                <td>@sw.StraightId</td>
                <td>@sw.DeviationId</td>
                <td>@(sw.IsDeviating ? "Deviazione" : "Dritto")</td>
            </tr>
        }
    </tbody>
</table>