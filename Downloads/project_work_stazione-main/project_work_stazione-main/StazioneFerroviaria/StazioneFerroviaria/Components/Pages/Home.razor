@page "/"

<div class="container py-5">
    <div class="text-center mb-5">
        <h1>Benvenuto alla Stazione</h1>
        <p class="lead">Controlla l'attività della stazione e gestisci i treni in transito, manutenzione e arrivo.</p>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card-custom">
                <h4>Binari disponibili</h4>
                <p>Visualizza lo stato attuale dei binari, treni e manutenzioni in corso.</p>
                <a href="/dashboard" class="btn btn-primary-custom">Apri Dashboard</a>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card-custom">
                <h4>Aggiungi un nuovo treno</h4>
                <p>Inserisci un nuovo treno e assegnalo a un binario libero.</p>
                <a href="/add-train" class="btn btn-primary-custom">Aggiungi Treno</a>
            </div>
        </div>
    </div>
</div>
