@page "/analytics"

<h3>Analisi Periodica Stazione</h3>
<p class="text-muted">Statistiche calcolate sui dati storici (<em>trains_log</em>) e sulle manutenzioni.</p>

@if (!loaded)
{
    <div class="d-flex align-items-center gap-2 my-4">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span>Caricamento dati...</span>
    </div>
}
else
{
    @* ── KPI riga 1: volumi e puntualità ─────────────────────────────────── *@
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-primary">@totalLogs</div>
                    <div class="text-muted small">Treni registrati</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <div class="fs-2 fw-bold @(punctualityPct >= 80 ? "text-success" : punctualityPct >= 60 ? "text-warning" : "text-danger")">
                        @punctualityPct.ToString("F1")%
                    </div>
                    <div class="text-muted small">Puntualità arrivi</div>
                    <div class="text-muted small">(@(totalLogs - lateCount) puntuali / @totalLogs)</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-warning">@avgDelayMin.ToString("F1") min</div>
                    <div class="text-muted small">Ritardo medio arrivo</div>
                    <div class="text-muted small">(@lateCount in ritardo)</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-info">@totalMaintenance</div>
                    <div class="text-muted small">Record manutenzione</div>
                </div>
            </div>
        </div>
    </div>

    @* ── KPI riga 2: saturazione binari morti ─────────────────────────────── *@
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold">Saturazione Binari Morti (Cargo S)</div>
                <div class="card-body">
                    @if (totalSTrains == 0)
                    {
                        <p class="text-muted mb-0">Nessun treno S nel log.</p>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between mb-1 small">
                            <span>Su binario morto: <strong>@sOnMaintenance / @totalSTrains</strong></span>
                            <span class="fw-bold @(maintenanceSaturation >= 70 ? "text-danger" : "text-success")">
                                @maintenanceSaturation.ToString("F1")%
                            </span>
                        </div>
                        <div class="progress" style="height:16px">
                            <div class="progress-bar @(maintenanceSaturation >= 70 ? "bg-danger" : maintenanceSaturation >= 40 ? "bg-warning" : "bg-success")"
                                 style="width:@maintenanceSaturation.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%">
                            </div>
                        </div>
                        <div class="text-muted small mt-1">
                            @(totalSTrains - sOnMaintenance) su binario di transito (overflow)
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold">Tempo Medio in Stazione per Tipo</div>
                <div class="card-body">
                    @if (stationTimes.Count == 0)
                    {
                        <p class="text-muted mb-0">Nessun dato disponibile.</p>
                    }
                    else
                    {
                        var maxTime = stationTimes.Max(r => r.AvgMinutes);
                        @foreach (var row in stationTimes)
                        {
                            var pct = maxTime > 0 ? row.AvgMinutes / maxTime * 100 : 0;
                            <div class="mb-2">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span><strong>@row.TrainType</strong> — @GetTypeName(row.TrainType)</span>
                                    <span class="text-muted">@row.AvgMinutes.ToString("F1") min  (@row.Count treni)</span>
                                </div>
                                <div class="progress" style="height:12px">
                                    <div class="progress-bar bg-info"
                                         style="width:@pct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%">
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Distribuzione per tipo + occupazione binari ─────────────────────── *@
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold">Distribuzione per Tipo Treno</div>
                <div class="card-body p-0">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Descrizione</th>
                                <th class="text-end">n°</th>
                                <th class="text-end">% tot.</th>
                                <th class="text-end">Ritardo medio</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in byType)
                            {
                                <tr>
                                    <td><strong>@row.TrainType</strong></td>
                                    <td>@GetTypeName(row.TrainType)</td>
                                    <td class="text-end">@row.Count</td>
                                    <td class="text-end">
                                        @(totalLogs > 0 ? $"{(double)row.Count / totalLogs * 100:F1}%" : "-")
                                    </td>
                                    <td class="text-end @(row.AvgDelayMin > 0 ? "text-danger" : "text-success")">
                                        @(row.AvgDelayMin >= 0 ? $"+{row.AvgDelayMin:F1}" : $"{row.AvgDelayMin:F1}") min
                                    </td>
                                </tr>
                            }
                            @if (byType.Count == 0)
                            {
                                <tr><td colspan="5" class="text-center text-muted">Nessun dato</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold">Utilizzo Binari di Transito</div>
                <div class="card-body p-0">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Binario</th>
                                <th class="text-end">Passaggi</th>
                                <th>% utilizzo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in platformUsage)
                            {
                                <tr>
                                    <td>Transit @row.Platform</td>
                                    <td class="text-end">@row.Count</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:10px">
                                                <div class="progress-bar bg-primary"
                                                     style="width:@row.Pct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%">
                                                </div>
                                            </div>
                                            <span class="small">@row.Pct.ToString("F1")%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (platformUsage.Count == 0)
                            {
                                <tr><td colspan="3" class="text-center text-muted">Nessun dato</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @* ── Confronto ritardi passeggeri ─────────────────────────────────────── *@
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Confronto Ritardi per Tipo Passeggeri (R / V / F)</div>
                <div class="card-body">
                    @{
                        var passByType = byType.Where(r => r.TrainType is "R" or "V" or "F").ToList();
                        var maxDelay   = passByType.Select(r => r.AvgDelayMin).DefaultIfEmpty(1).Max();
                    }
                    @if (passByType.Count == 0)
                    {
                        <p class="text-muted">Nessun dato su treni passeggeri nel log.</p>
                    }
                    else
                    {
                        @foreach (var row in passByType)
                        {
                            var pct = maxDelay > 0 ? Math.Max(0, row.AvgDelayMin / maxDelay * 100) : 0;
                            <div class="mb-2">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span><strong>@row.TrainType</strong> – @GetTypeName(row.TrainType)</span>
                                    <span>@row.AvgDelayMin.ToString("F1") min</span>
                                </div>
                                <div class="progress" style="height:14px">
                                    <div class="progress-bar @(row.AvgDelayMin > 5 ? "bg-danger" : row.AvgDelayMin > 2 ? "bg-warning" : "bg-success")"
                                         style="width:@pct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%">
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Ultime manutenzioni ──────────────────────────────────────────────── *@
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold">Ultime Manutenzioni (@totalMaintenance totali)</div>
        <div class="card-body p-0">
            <table class="table table-sm table-striped mb-0">
                <thead>
                    <tr>
                        <th>Treno</th>
                        <th>Tipo</th>
                        <th>Binario</th>
                        <th>Inizio</th>
                        <th>Fine prevista</th>
                        <th class="text-end">Durata (h)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in lastMaintenances)
                    {
                        var dur = (m.MaintenanceEnd - m.MaintenanceStart).TotalHours;
                        <tr>
                            <td>@(m.TrainLog?.TrainNumber ?? "N/A")</td>
                            <td>@(m.TrainLog?.TrainType ?? "-")</td>
                            <td>@(m.MaintenancePlatform?.ToString() ?? "morto")</td>
                            <td>@m.MaintenanceStart.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            <td>@m.MaintenanceEnd.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            <td class="text-end">@dur.ToString("F1")</td>
                        </tr>
                    }
                    @if (lastMaintenances.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted">Nessuna manutenzione registrata</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="text-muted small">
        Ultimo aggiornamento: @lastRefresh.ToLocalTime().ToString("HH:mm:ss")
        <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="LoadDataAsync">↺ Aggiorna</button>
    </div>
}
