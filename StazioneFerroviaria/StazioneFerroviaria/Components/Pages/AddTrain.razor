@page "/add-train"
@inject FerroviaApi.Data.FerroviaApiDbContext Db
@inject NavigationManager Nav
@inject StazioneFerroviaria.Services.TrainNotificationService TrainNotification

<h3>Aggiungi Treno</h3>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<EditForm Model="train" OnValidSubmit="SaveTrain">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Numero Treno</label>
        <InputText class="form-control" @bind-Value="train.TrainNumber" />
    </div>

    <div class="mb-3">
        <label>Tipo Treno</label>
        <InputSelect class="form-control" @bind-Value="train.TrainType">
            <option value="R">Regionale</option>
            <option value="V">Veloce</option>
            <option value="F">Freccia</option>
            <option value="T">Merci Transito</option>
            <option value="S">Cargo Stazionante</option>
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Lunghezza</label>
        <InputNumber class="form-control" @bind-Value="train.Length" />
    </div>

    <div class="mb-3">
        <label>Origine</label>
        <InputSelect class="form-control" @bind-Value="train.Origin">
            <option value="L1">L1</option>
            <option value="R1">R1</option>
            <option value="L2">L2</option>
            <option value="R2">R2</option>
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Destinazione</label>
        <InputSelect class="form-control" @bind-Value="train.Destination">
            <option value="L">L</option>
            <option value="R">R</option>
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Binario</label>
        <InputSelect class="form-control" @bind-Value="selectedPlatform">
            <option value="0">-- Seleziona --</option>
            @foreach (var s in sectors)
            {
                <option value="@s.PlatformNumber">Binario @s.PlatformNumber</option>
            }
        </InputSelect>
    </div>

    <div class="form-check mb-3">
        <InputCheckbox class="form-check-input" @bind-Value="train.IsTransit" />
        <label class="form-check-label">In transito</label>
    </div>

    <div class="form-check mb-3">
        <InputCheckbox class="form-check-input" @bind-Value="isMaintenance" />
        <label class="form-check-label">In manutenzione</label>
    </div>

    <button class="btn btn-primary" type="submit">Salva</button>
</EditForm>