@page "/add-train"
@inject FerroviaApi.Data.FerroviaApiDbContext Db
@inject NavigationManager Nav

<h3>Aggiungi Treno</h3>

<EditForm Model="train" OnValidSubmit="SaveTrain">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Numero Treno</label>
        <InputText class="form-control" @bind-Value="train.TrainNumber" />
    </div>

    <div class="mb-3">
        <label>Tipo Treno</label>
        <InputSelect class="form-control" @bind-Value="train.TrainType">
            <option value="R">Regionale</option>
            <option value="V">Veloce</option>
            <option value="F">Freccia</option>
            <option value="S">Cargo Stazionante</option>
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Lunghezza</label>
        <InputNumber class="form-control" @bind-Value="train.Length" />
    </div>

    <div class="mb-3">
        <label>Origine</label>
        <InputSelect class="form-control" @bind-Value="train.Origin">
            <option value="L1">L1</option>
            <option value="R1">R1</option>
            <option value="L2">L2</option>
            <option value="R2">R2</option>
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Destinazione</label>
        <InputSelect class="form-control" @bind-Value="train.Destination">
            <option value="L">L</option>
            <option value="R">R</option>
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Arrivo programmato</label>
        <InputDate class="form-control" @bind-Value="train.ScheduledArrivalTime" />
    </div>

    <div class="mb-3">
        <label>Partenza programmata</label>
        <InputDate class="form-control" @bind-Value="train.ScheduledDepartureTime" />
    </div>

    <div class="form-check mb-3">
        <InputCheckbox class="form-check-input" @bind-Value="train.IsTransit" />
        <label class="form-check-label">In transito</label>
    </div>

    <button class="btn btn-primary">Salva</button>
</EditForm>