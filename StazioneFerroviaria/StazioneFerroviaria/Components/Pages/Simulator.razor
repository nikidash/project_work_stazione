@page "/simulator"
@inject StazioneFerroviaria.Services.SimulationService SimService

<h3>Simulatore Stazione</h3>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <button class="btn btn-success" @onclick="Play" disabled="@_isRunning">
                Play
            </button>
            <button class="btn btn-warning" @onclick="Pause" disabled="@(!_isRunning)">
                Pausa
            </button>
            <button class="btn btn-primary" @onclick="Step">
                Step
            </button>
            <button class="btn btn-danger" @onclick="DoReset">
                Reset
            </button>
            <div class="ms-auto d-flex align-items-center gap-2">
                <label class="form-label mb-0">Velocita' (@(_speed)ms)</label>
                <input type="range" class="form-range" style="width: 200px;"
                       min="200" max="5000" step="100"
                       value="@_speed" @onchange="OnSpeedChanged" />
            </div>
        </div>
        <div>
            <span class="badge bg-info">Tick: @SimService.TickCount</span>
            <span class="badge @(_isRunning ? "bg-success" : "bg-secondary") ms-2">
                @(_isRunning ? "In esecuzione" : "In pausa")
            </span>
        </div>
    </div>
</div>

<h4>Layout stazione</h4>
<StationLayout Tracks="SimService.Tracks" />
