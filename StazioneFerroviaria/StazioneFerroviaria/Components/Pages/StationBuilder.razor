@page "/station-builder"
@using StazioneFerroviaria.Models.StationBuilder

<PageTitle>Station Line Builder</PageTitle>

<h1>Station Line Builder</h1>
<p>Draw the station layout with lines. Each grid segment length represents a 2-car track sector. SVG and JSON outputs are generated below.</p>

<div class="mb-3">
    <h4>Select Tool:</h4>
    <div class="btn-group" role="group">
        <button class="btn @(SelectedTool == ElementTool.DrawTrack ? "btn-primary" : "btn-outline-primary")" @onclick="() => SelectTool(ElementTool.DrawTrack)">Draw Track</button>
        <button class="btn @(SelectedTool == ElementTool.DrawPlatform ? "btn-primary" : "btn-outline-primary")" @onclick="() => SelectTool(ElementTool.DrawPlatform)">Draw Platform</button>
        <button class="btn @(SelectedTool == ElementTool.DrawStorage ? "btn-info" : "btn-outline-info")" @onclick="() => SelectTool(ElementTool.DrawStorage)">Draw Storage</button>
        <button class="btn @(SelectedTool == ElementTool.ToggleSwitch ? "btn-warning" : "btn-outline-warning")" @onclick="() => SelectTool(ElementTool.ToggleSwitch)">Mark Switch</button>
        <button class="btn @(SelectedTool == ElementTool.ToggleCrossing ? "btn-danger" : "btn-outline-danger")" @onclick="() => SelectTool(ElementTool.ToggleCrossing)">Mark Crossing</button>
        <button class="btn @(SelectedTool == ElementTool.Erase ? "btn-dark" : "btn-outline-dark")" @onclick="() => SelectTool(ElementTool.Erase)">Erase</button>
    </div>
    @if(SelectedTool == ElementTool.DrawPlatform)
    {
        <div class="d-inline-flex align-items-center ms-2" style="background:#e9ecef; padding: 2px 10px; border-radius: 4px;">
            <label class="form-label mb-0 me-2 fw-bold text-success" style="font-size: 0.9em;">No.</label>
            <input type="number" class="form-control form-control-sm text-center fw-bold" style="width: 60px; color: #155724;" @bind="ActivePlatformNumber" min="1" max="99" />
        </div>
    }
    <button class="btn btn-danger ms-3" @onclick="ClearGrid">Clear Layout</button>
    <button class="btn btn-success ms-3" @onclick="SaveLayout">Save Layout</button>
    
    @if(ShowSaveSuccess)
    {
        <span class="ms-3 text-success fw-bold">Layout saved successfully!</span>
    }
    else if(ActiveDrawNode != null)
    {
        <span class="ms-3 text-info">Drawing from (@ActiveDrawNode.X, @ActiveDrawNode.Y)... Click elsewhere to connect, or click same dot to stop.</span>
    }
</div>

<div class="svg-container" style="border: 1px solid #ccc; background-color: #f8f9fa; width: 1000px; height: 600px; overflow: auto; cursor: crosshair; user-select: none;">
    <svg width="1000" height="600" xmlns="http://www.w3.org/2000/svg">
        <!-- Grid Background -->
        <defs>
            <pattern id="smallGrid" width="@GridSpacing" height="@GridSpacing" patternUnits="userSpaceOnUse">
                <circle cx="@(GridSpacing/2)" cy="@(GridSpacing/2)" r="1.5" fill="#ddd" />
            </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#smallGrid)" />
        
        <!-- Segments -->
        @foreach (var segment in Layout.Segments)
        {
            var start = GetNode(segment.StartNodeId);
            var end = GetNode(segment.EndNodeId);
            if (start != null && end != null)
            {
                var cssClass = segment.IsPlatform ? "stroke: #28a745; stroke-width: 8;" : 
                               segment.IsStorage ? "stroke: #0dcaf0; stroke-width: 6;" : 
                               "stroke: #6c757d; stroke-width: 4;";
                <line x1="@(start.X * GridSpacing + GridSpacing/2)" 
                      y1="@(start.Y * GridSpacing + GridSpacing/2)" 
                      x2="@(end.X * GridSpacing + GridSpacing/2)" 
                      y2="@(end.Y * GridSpacing + GridSpacing/2)" 
                      style="@cssClass stroke-linecap: round;" />
                      
                <!-- Interaction overlay line -->
                <line x1="@(start.X * GridSpacing + GridSpacing/2)" 
                      y1="@(start.Y * GridSpacing + GridSpacing/2)" 
                      x2="@(end.X * GridSpacing + GridSpacing/2)" 
                      y2="@(end.Y * GridSpacing + GridSpacing/2)" 
                      style="stroke: transparent; stroke-width: 15;" 
                      @onclick="() => OnSegmentClick(segment)" />
            }
        }
        
        <!-- Platform Numbers -->
        @foreach (var segment in Layout.Segments.Where(s => s.IsPlatform && s.PlatformNumber.HasValue))
        {
            var start = GetNode(segment.StartNodeId);
            var end = GetNode(segment.EndNodeId);
            if (start != null && end != null)
            {
                <svg:text x="@(((start.X + end.X) * GridSpacing / 2) + GridSpacing/2)" 
                      y="@(((start.Y + end.Y) * GridSpacing / 2) + GridSpacing/2 - 8)" 
                      font-size="10" fill="#155724" text-anchor="middle" font-weight="bold" 
                      style="pointer-events:none;">
                    P@(segment.PlatformNumber)
                </svg:text>
            }
        }

        <!-- Nodes -->
        @foreach (var node in Layout.Nodes)
        {
            int px = node.X * GridSpacing + GridSpacing/2;
            int py = node.Y * GridSpacing + GridSpacing/2;
            
            if (node.IsSwitch)
            {
                <circle cx="@px" cy="@py" r="6" fill="#ffc107" stroke="#333" stroke-width="2" />
            }
            else if (node.IsCrossing)
            {
                <circle cx="@px" cy="@py" r="6" fill="#dc3545" stroke="#333" stroke-width="2" />
            }
            else
            {
                <circle cx="@px" cy="@py" r="3" fill="#333" />
            }
            
            <!-- Active drawing highlight -->
            @if (ActiveDrawNode?.Id == node.Id)
            {
                <circle cx="@px" cy="@py" r="8" fill="none" stroke="#007bff" stroke-width="2" />
            }
        }

        <!-- Interactive Grid Overlays (Click targets) -->
        @for (int x = 0; x < GridCols; x++)
        {
            for (int y = 0; y < GridRows; y++)
            {
                int localX = x;
                int localY = y;
                int px = x * GridSpacing + GridSpacing/2;
                int py = y * GridSpacing + GridSpacing/2;
                
                <circle cx="@px" cy="@py" r="8" fill="transparent" 
                        @onclick="() => OnGridClick(localX, localY)" />
            }
        }
    </svg>
</div>

<div class="row mt-4 mb-5">
    <div class="col-md-6">
        <h4>Generated JSON:</h4>
        <textarea class="form-control" rows="12" readonly style="font-family: monospace; font-size: 0.85em;">@GeneratedJson</textarea>
    </div>
    <div class="col-md-6">
        <h4>Generated SVG:</h4>
        <textarea class="form-control" rows="12" readonly style="font-family: monospace; font-size: 0.85em;">@GeneratedSvg</textarea>
    </div>
</div>
